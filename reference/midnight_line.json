    "title": "Midnight Line"
  },
  "messages": {
    "ML_RelayHall": {
      "id": 207,
      "string": 1087,
      "text": "The relay hall. Steel walls give no grip. The catwalks take turns being live."
    },
    "ML_Roof": {
      "id": 208,
      "string": 1088,
      "text": "The control roof. They knew you were coming: three crews, one after another."
    },
    "ML_Roof_clear": {
      "id": 209,
      "string": 1089,
      "text": "Substation 7 is yours. The roof is open whenever you want another round."
    },
    "ML_ServiceBay": {
      "id": 212,
      "string": 1092,
      "text": "Maintenance bay. A quiet checkpoint for the Substation. Save and gear up."
    },
    "ML_SignalCore": {
      "id": 210,
      "string": 1090,
      "text": "Break any bright core. Yellow warns; blue arcs hurt. Green safe. \ue603 cuts power."
    },
    "ML_SignalCore_clear": {
      "id": 211,
      "string": 1091,
      "text": "Signal Leech is dead. The Midnight Line is clear of its interference."
    },
    "ML_Switchyard": {
      "id": 206,
      "string": 1086,
      "text": "Oscorp Substation 7 feeds the Midnight Line. The crew guarding it looks paid."
    },
    "breaker": {
      "id": 197,
      "string": 1077,
      "text": "Track power cut. The boiler on the tracks can be moved now."
    },
    "goal_done": {
      "id": 200,
      "string": 1080,
      "text": "The Midnight Line is quiet. For now."
    },
    "goal_leech": {
      "id": 201,
      "string": 1081,
      "text": "Substation 7 is past the Yard. Shut down Signal Leech beyond the control roof."
    },
    "goal_nest": {
      "id": 199,
      "string": 1079,
      "text": "Objective: something nests under the tracks. Move the boiler and go down."
    },
    "goal_power": {
      "id": 198,
      "string": 1078,
      "text": "Objective: cut the track power. The breaker is on the Stairs."
    },
    "grate_clear": {
      "id": 203,
      "string": 1083,
      "text": "The grate is clear. Stand on it, open it with X and drop in with Down."
    },
    "live_tracks": {
      "id": 196,
      "string": 1076,
      "text": "The tracks are live. Cut the power before touching that boiler."
    },
    "sealed_grate": {
      "id": 202,
      "string": 1082,
      "text": "Sealed from below. The way down must be somewhere on the tracks."
    },
    "way_up": {
      "id": 204,
      "string": 1084,
      "text": "The nest falls silent. Take the left passage: a shaft climbs back to the Stairs."
    },
    "yard": {
      "id": 205,
      "string": 1085,
      "text": "A freight yard above the line. Someone made camp here, and they have seen you."
    }
  },
