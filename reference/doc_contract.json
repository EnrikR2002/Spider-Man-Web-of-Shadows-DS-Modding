{
  "schema_version": 1,
  "purpose": "Machine-checked documentation rules. tools/doc_contract.py check enforces every rule here and tests.test_document_layout runs it. Change this file only when the user changes documentation policy; never weaken a rule to make a check pass.",
  "documents": [
    {
      "path": "AGENTS.md",
      "owns": "Stable constraints, startup procedure and documentation policy",
      "audience": "agent",
      "max_words": 900,
      "required_headings": [
        "# Project instructions",
        "## Start and find the current truth",
        "## Documentation ownership",
        "## Task completion and Git",
        "## Safety and validation",
        "## Player direction"
      ],
      "edit_policy": "Change only when the user changes direction or policy; keep the ownership table in step with this contract."
    },
    {
      "path": "README.md",
      "owns": "Short entry point, play instructions, current release and document map",
      "audience": "player and agent",
      "required_headings": [
        "# Spider-Man: Web of Shadows DS modding",
        "## Find what you need",
        "## Local setup"
      ],
      "required_patterns": [
        "Current release: \\*\\*v\\d+\\.\\d+\\.\\d+\\*\\*"
      ],
      "edit_policy": "Update the current-release sentence at each publication; keep it short."
    },
    {
      "path": "mods/README.md",
      "owns": "Overlay-loader rules for private mods/",
      "audience": "agent",
      "required_headings": [
        "# Personal overlays"
      ],
      "edit_policy": "The only non-asset file the overlay loader ignores; change only with the loader."
    },
    {
      "path": "docs/TASKS.md",
      "owns": "Current objective, published build, evidence, blocker and next exact action",
      "audience": "player and agent",
      "max_words": 900,
      "required_headings": [
        "# Current work and handoff",
        "## Current objective",
        "## Published build",
        "## Blockers and next exact action"
      ],
      "required_patterns": [
        "^Updated \\d{4}-\\d{2}-\\d{2}"
      ],
      "edit_policy": "Replace stale state at milestones and before stopping; never append a history log."
    },
    {
      "path": "docs/DEVELOPMENT.md",
      "owns": "Environment, build stack, feature recipe, qualification, evidence and release workflow",
      "audience": "agent",
      "required_headings": [
        "# Development and validation",
        "## Know your environment",
        "## Establish the current state",
        "## How a release is built",
        "## Add a feature as a new post-pass",
        "## Find the implementation",
        "## Run focused qualification",
        "## Release and handoff",
        "## Maintain documentation"
      ],
      "edit_policy": "Reusable workflow only; engine facts go to TECHNICAL and results to reference/ receipts."
    },
    {
      "path": "docs/TECHNICAL.md",
      "owns": "Engine/format contracts, discoveries, unknowns and evidence",
      "audience": "agent",
      "required_headings": [
        "# ROM technical knowledge",
        "## Topic map"
      ],
      "edit_policy": "Add each discovery to its owning topic section with date, confidence and source version; mark superseded claims instead of deleting them; add a topic-map row for a new topic; never bulk-rewrite."
    },
    {
      "path": "docs/OG_GAMEPLAY.md",
      "owns": "Original game behavior before modifications",
      "audience": "agent",
      "required_headings": [
        "# Original game behavior"
      ],
      "edit_policy": "Native behavior only; mod behavior goes to CHANGES."
    },
    {
      "path": "docs/CHANGES.md",
      "owns": "Shipped behavior, numbered release history and validation limits",
      "audience": "agent",
      "required_headings": [
        "# Implemented changes and releases",
        "## Version policy"
      ],
      "edit_policy": "Add one section per publication above the previous one; published sections are frozen by hash (freeze with tools/doc_contract.py freeze)."
    },
    {
      "path": "docs/ROADMAP.md",
      "owns": "Whole-game designs, Now table, idea backlog and player feedback log",
      "audience": "player and agent",
      "required_headings": [
        "# Roadmap",
        "## Now",
        "## Player direction",
        "## Idea backlog",
        "## Player feedback log",
        "## Historical designs"
      ],
      "edit_policy": "Record player verdicts newest first the day they are given; archive a retired design with tools/doc_archive.py add before removing it."
    }
  ],
  "routing": [
    {
      "content": "Engine or format discovery, address, unknown, confidence",
      "destination": "docs/TECHNICAL.md",
      "how": "owning topic section; date, confidence, source version"
    },
    {
      "content": "Reusable command, workflow, tool usage or trap",
      "destination": "docs/DEVELOPMENT.md",
      "how": "matching workflow section"
    },
    {
      "content": "Published behavior and validation limits",
      "destination": "docs/CHANGES.md",
      "how": "new top section at publication, then freeze"
    },
    {
      "content": "Player verdict, request or design decision",
      "destination": "docs/ROADMAP.md",
      "how": "feedback log row (newest first) and the owning design section"
    },
    {
      "content": "Current objective, build, blocker, next action",
      "destination": "docs/TASKS.md",
      "how": "replace stale state"
    },
    {
      "content": "Native game behavior",
      "destination": "docs/OG_GAMEPLAY.md",
      "how": "matching section"
    },
    {
      "content": "Exact hashes, receipts, recipes, catalogs, fixture limits",
      "destination": "reference/*.json",
      "how": "compact receipt per feature/release"
    },
    {
      "content": "Retired design or catalog",
      "destination": "docs/archive (tools/doc_archive.py add)",
      "how": "archive first, then remove from the live doc"
    },
    {
      "content": "Scratch scripts, traces, captures, large reports",
      "destination": "work/ or build/ (ignored)",
      "how": "never committed"
    }
  ],
  "forbidden": [
    "Any Markdown file outside the documents list",
    "Per-session, per-release or handoff notes",
    "Changing a frozen CHANGES section without the user asking (then refreeze with --update)",
    "Copying volatile hashes, runtime addresses or test logs into AGENTS, TASKS or README",
    "Removing a retired design before archiving it",
    "Claiming in-game results from a workspace without the ROM and emulator"
  ],
  "version_sources": [
    "reference/gameplay_profile.json release_version",
    "reference/releases.json last release",
    "docs/CHANGES.md first version heading",
    "README.md \"Current release\"",
    "docs/TASKS.md \"## Published build\" first **vX.Y.Z**"
  ],
  "changes_heading_pattern": "^## v(\\d+)\\.(\\d+)\\.(\\d+) - (\\d{4}-\\d{2}-\\d{2}) - \\S",
  "spacing_pattern": "\\b(on|On|all|All|and|at|the|of|to|For|for|with|from|use|uses|across|about)\\d",
  "feedback_log_heading": "## Player feedback log",
